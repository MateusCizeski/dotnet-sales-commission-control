# Copy to .env (not versioned) and replace every value. Fictitious examples only.

# SQL Server "sa" password: 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=Change-me-Str0ng!

# JWT signing key: at least 32 characters. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Users created on the first start (Development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Change-me-admin-1
SEED_SELLER_EMAIL=seller@example.com
SEED_SELLER_PASSWORD=Change-me-seller-1
