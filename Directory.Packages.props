<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApiBase (read side). 3.0.0 is not on nuget.org yet: see README > "Building before ApiBase 3.0.0 is published". -->
    <PackageVersion Include="ApiBase.Domain" Version="3.0.0" />
    <PackageVersion Include="ApiBase.Repository" Version="3.0.0" />
    <PackageVersion Include="ApiBase.Application" Version="3.0.0" />
    <PackageVersion Include="ApiBase.Controller" Version="3.0.0" />

    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />

    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />

    <!-- Transitive pin (via Microsoft.Data.SqlClient): 9.0.11 has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />

    <!-- Front exports. Licenses: see README > Third-party licenses. -->
    <PackageVersion Include="EPPlus" Version="6.2.1" />
    <PackageVersion Include="QuestPDF" Version="2024.12.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
</Project>
