@page "{id:guid}"
@model Front.Pages.Invoices.EditModel
@{
    ViewData["Title"] = "Edit invoice";
}

<h1>Edit invoice @Model.Number</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.SellerId" class="form-label"></label>
        <select asp-for="Input.SellerId" asp-items="Model.Sellers" class="form-select"></select>
        <span asp-validation-for="Input.SellerId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.TotalAmount" class="form-label"></label>
        <input asp-for="Input.TotalAmount" class="form-control" step="0.01" />
        <span asp-validation-for="Input.TotalAmount" class="text-danger"></span>
        <div class="form-text">The commission is recalculated with the selected seller's current rate.</div>
    </div>

    <button class="btn btn-success">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
