@page
@model Front.Pages.Invoices.IndexModel
@using Front.Models
@{
    ViewData["Title"] = "Invoices";
}

<h1>Invoices</h1>

<partial name="_Messages" model="Model" />

@if (Model.IsAdmin)
{
    <a asp-page="Create" class="btn btn-success mb-3">New invoice</a>
}

<form method="get" class="mb-3 row g-2 align-items-end">
    @if (Model.IsAdmin)
    {
        <div class="col-md-3">
            <label class="form-label">Seller</label>
            <select name="SellerId" class="form-select">
                <option value="">All</option>
                @foreach (var seller in Model.Sellers)
                {
                    <option value="@seller.Id" selected="@(Model.SellerId == seller.Id)">@seller.FullName</option>
                }
            </select>
        </div>
    }

    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select name="Status" class="form-select">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<InvoiceStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <partial name="_PageSizeSelect" model="Model" />
    </div>

    <div class="col-md-1">
        <button class="btn btn-primary">Search</button>
    </div>

    <div class="col d-flex justify-content-end">
        <a asp-page-handler="ExportExcel" asp-all-route-data="Model.RouteFilters" class="btn btn-outline-success me-2">Export Excel</a>
        <a asp-page-handler="ExportPdf" asp-all-route-data="Model.RouteFilters" class="btn btn-outline-danger">Export PDF</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Number</th>
            <th>Seller</th>
            <th>Customer</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Issue date</th>
            @if (Model.IsAdmin)
            {
                <th style="width:260px">Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model.Invoices)
        {
            <tr>
                <td>@invoice.Number</td>
                <td>@invoice.Seller?.FullName</td>
                <td>@invoice.CustomerName</td>
                <td>@invoice.TotalAmount.ToString("C")</td>
                <td>
                    @switch (invoice.Status)
                    {
                        case InvoiceStatus.Pending:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                        case InvoiceStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case InvoiceStatus.Cancelled:
                            <span class="badge bg-danger">Cancelled</span>
                            break;
                    }
                </td>
                <td>@invoice.IssueDate.ToShortDateString()</td>
                @if (Model.IsAdmin)
                {
                    <td class="d-flex gap-1">
                        @if (invoice.Status == InvoiceStatus.Pending)
                        {
                            <a asp-page="Edit" asp-route-id="@invoice.Id" class="btn btn-sm btn-primary">Edit</a>

                            <form method="post" asp-page-handler="Approve" asp-all-route-data="Model.RouteFor(invoice.Id)">
                                <button class="btn btn-sm btn-success">Approve</button>
                            </form>
                        }

                        @if (invoice.Status != InvoiceStatus.Cancelled)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-all-route-data="Model.RouteFor(invoice.Id)" onsubmit="return confirm('Cancel this invoice and its commission?');">
                                <button class="btn btn-sm btn-danger">Cancel</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<partial name="_Pager" model="Model" />
