@model Front.Pages.ApiPageModel
@{
    // Keeps the current filters (query string) and changes only the page.
    var query = Context.Request.Query
        .Where(q => !q.Key.Equals("CurrentPage", StringComparison.OrdinalIgnoreCase) && !q.Key.Equals("handler", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(q => q.Key, q => q.Value.ToString());

    string Link(int page)
    {
        var values = new Dictionary<string, string?>(query.Select(q => new KeyValuePair<string, string?>(q.Key, q.Value))) { ["CurrentPage"] = page.ToString() };
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, values);
    }
}

<nav aria-label="Pagination" class="mt-3">
    <ul class="pagination justify-content-end mb-0">
        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
            <a class="page-link" href="@Link(Model.CurrentPage - 1)">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalItems items)</span>
        </li>
        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Link(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
